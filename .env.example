# Empty API key enables deterministic, clearly labeled demo mode.
DO_API_KEY=
DO_INFERENCE_ENDPOINT=https://inference.do-ai.run/v1
# Examples, NOT a guarantee these are in your serverless catalog.
# Query /v1/models and configure exact IDs or use a dedicated endpoint.
DO_MODEL_ECO=llama-3.2-3b-instruct
DO_MODEL_BALANCED=qwen2.5-coder-7b-instruct
DO_MODEL_HEAVY=llama3.3-70b-instruct
DO_PLANNER_MODEL=hermes-3-llama-3.1-8b
PLANNER_MODE=rules
ROUTER_API_KEY=
ECO_ROUTER_URL=http://127.0.0.1:8000
CACHE_MAX_ENTRIES=256
CACHE_TTL_SECONDS=900
UPSTREAM_TIMEOUT_SECONDS=90
DEMO_FAIL_ECO=false
# Illustrative assumptions, not measured energy or DigitalOcean price quotes.
ECO_WH_PER_1K=0.05
BALANCED_WH_PER_1K=0.15
HEAVY_WH_PER_1K=0.50
ECO_USD_PER_MILLION=0.10
BALANCED_USD_PER_MILLION=0.30
HEAVY_USD_PER_MILLION=1.00
# Optional PyDo control-plane helper (separate from inference credentials).
DIGITALOCEAN_TOKEN=
